# =============================================================================
# TEMPLATE .env PRODUKSI — salin ke `.env` di server, lalu isi nilai sebenarnya.
# JANGAN commit `.env` asli ke git. Generate APP_KEY: `php artisan key:generate`
# =============================================================================

APP_NAME="Taksi Angkasa Jaya"
APP_ENV=production            # [#1] WAJIB production (bukan local)
APP_KEY=                      # [#1] isi via: php artisan key:generate
APP_DEBUG=false               # [#1] WAJIB false — kalau true, stack trace + kredensial DB/.env BOCOR ke publik saat error
APP_URL=https://kaj.aptpairport.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily               # rotasi log harian (jangan 'single' yang membengkak tak terbatas)
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # produksi: error saja (bukan debug)

# --- [#3] Database: MySQL/MariaDB (bukan SQLite) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taksi_pos
DB_USERNAME=taksi_user
DB_PASSWORD=                  # password kuat & unik

# --- Session: PENTING agar panel admin (berbasis cookie) bisa auth ke /api/* ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.kaj.aptpairport.id   # domain produksi (awali titik utk mencakup subdomain)
SESSION_SECURE_COOKIE=true           # cookie hanya via HTTPS

# --- Sanctum: KRITIS. Tanpa ini panel admin dapat 401 di SEMUA panggilan API ---
# (Panel admin login lewat sesi web; /api/* diverifikasi sebagai "first-party"
#  HANYA jika host-nya terdaftar di sini. Aplikasi driver/CSO pakai Bearer token,
#  jadi tidak terpengaruh.)
SANCTUM_STATEFUL_DOMAINS=kaj.aptpairport.id

QUEUE_CONNECTION=database     # butuh worker (lihat DEPLOYMENT.md → Supervisor)
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Email (notifikasi pencairan dana) — bisa juga diatur via panel Admin > Pengaturan ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@kaj.aptpairport.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- FCM (notifikasi order ke HP driver) ---
# Pastikan file service-account JSON Firebase ada di server & path-nya benar
# (lihat cara pemakaian di CsoApiController/pushFcmToDriver). Jangan commit file ini.

# --- [#15] Sentry: pemantauan error realtime (sangat disarankan untuk produksi) ---
# Daftar gratis di https://sentry.io → buat project "Laravel" → salin DSN ke bawah.
# Kalau DSN dikosongkan, Sentry OTOMATIS NONAKTIF (app tetap jalan normal).
# Dengan ini, tiap error 500 di server langsung terkirim ke dashboard Sentry
# (lengkap dgn stack trace, user, & request) — tahu ada bug sebelum user komplain.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2     # rekam 20% request utk profiling performa (0=mati, 1=semua)
SENTRY_SEND_DEFAULT_PII=false     # JANGAN kirim data pribadi (IP/nama) ke Sentry
